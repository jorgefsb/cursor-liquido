{
  "name": "cursor-liquido",
  "version": "1.0.1-rc.1",
  "description": "Liquid cursor trail for the web: dots or a WebGL2 fluid behind the native pointer. Zero runtime dependencies.",
  "private": true,
  "license": "MIT",
  "author": "Jorge Suárez",
  "homepage": "https://github.com/jorgefsb/cursor-liquido#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorgefsb/cursor-liquido.git"
  },
  "main": "dist/cursor-liquido.js",
  "style": "dist/cursor-liquido.css",
  "files": [
    "dist/",
    "src/",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": ["cursor", "fluid", "webgl2", "game-feel", "juice"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.cjs",
    "test": "node --test tests/unit/release.test.cjs",
    "test:browser": "node tests/browser/regression.cjs",
    "test:quality": "node tests/browser/quality-transition.cjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  }
}
